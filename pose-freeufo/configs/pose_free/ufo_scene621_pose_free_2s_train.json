{
  "arch": "small",
  "model": "UFO-B/8",
  "data_root": "data/UFO_paper",
  "dataset": "waymo",
  "train_scene_indices": "621",
  "disable_validation": true,
  "input_size": [
    160,
    240
  ],
  "num_max_cameras": 3,
  "timespan": 0.5,
  "num_context_timesteps": 1,
  "num_target_timesteps": 2,
  "num_target_chunks": 4,
  "paper_frame_protocol": true,
  "paper_supervision_mode": "per_chunk",
  "paper_forward_flow_impl": false,
  "batch_size": 1,
  "gradient_accumulation_steps": 1,
  "ddp_accumulation_no_sync": false,
  "attention_mode": "official_v1_dense",
  "eval_batch_size": 1,
  "num_workers": 8,
  "pin_memory": true,
  "non_blocking_h2d": true,
  "prefetch_factor": 4,
  "num_bbox": 32,
  "num_motion_tokens": 0,
  "num_window_chunks": 0,
  "filter_num": 3600,
  "recurrent": true,
  "ar": true,
  "scene_token_input": "official_rgb",
  "detach_scene_between_chunks": false,
  "sequential_chunk_backward": false,
  "allow_old_scene_grad": false,
  "gaussian_decoder_layers": "mlp2",
  "recurrent_aux_tokens": true,
  "disable_legacy_time_offset": true,
  "paper_affine_transform": true,
  "paper_bbox_rotation": false,
  "mask_invalid_bbox_tokens": true,
  "stable_bbox_delta_transform": true,
  "enable_lifespan_renderer": true,
  "lifespan_parameterization": "paper_beta",
  "enable_lifespan_reg_loss": true,
  "lifespan_reg_coeff": 0.0001,
  "object_assignment_loss_coeff": 0.0,
  "object_assignment_background_weight": 0.1,
  "object_soft_target_temperature": 0.1,
  "use_sky_token": true,
  "use_affine_token": true,
  "enable_depth_loss": false,
  "depth_loss_coeff": 1.0,
  "depth_loss_normalization": "target_max",
  "enable_flow_reg_loss": false,
  "flow_reg_coeff": 0.005,
  "enable_sky_depth_loss": false,
  "sky_depth": 300.0,
  "enable_sky_opacity_loss": false,
  "sky_opacity_loss_coeff": 0.1,
  "legacy_sky_full_opacity_loss": false,
  "enable_perceptual_loss": true,
  "perceptual_weight": 0.05,
  "perceptual_loss_start_iter": 5000,
  "lr": 0.0001,
  "lr_sched": "constant",
  "warmup_iters": 5000,
  "weight_decay": 0.05,
  "grad_clip": 3.0,
  "disable_grad_checkpointing": true,
  "sparse_training_diagnostics": true,
  "diagnostic_interval": 100,
  "gaussian_diagnostic_interval": 500,
  "module_grad_norm_interval": 500,
  "num_iterations": 10000,
  "resume_from": null,
  "auto_resume": false,
  "load_depth": false,
  "load_flow": false,
  "disable_train_flow_loading": true,
  "load_ground": false,
  "load_dynamic_mask": false,
  "skip_sky_mask": true,
  "instance_scene_index_manifest": null,
  "output_dir": "outputs",
  "project": "pose_free_train",
  "exp_name": "GCA_Omega_uniform_10k",
  "training_sampling_mode": "uniform",
  "dynamic_rich_pool": null,
  "dynamic_sampling_ratio": 0.0,
  "enable_tensorboard": true,
  "allow_missing_paper_components": true,
  "log_every_n_iters": 25,
  "vis_every_n_iters": 0,
  "validation_steps": "",
  "ckpt_every_n_iters": 1000,
  "eval_every_n_iters": 0,
  "skip_initial_validation": true,
  "skip_final_evaluation": true,
  "seed": 1,
  "keep_n_ckpts": 12,
  "pose_free_training": true,
  "pose_free_camera_only": true,
  "pose_free_coordinate_mode": "recurrent",
  "pose_override_mode": "all",
  "pose_override_sequence_dir": "outputs/pose_free_camera/omega_gca_metric_all",
  "intrinsics_override_mode": "all",
  "intrinsics_override_sequence_dir": "outputs/pose_free_camera/omega_gca_metric_all"
}
