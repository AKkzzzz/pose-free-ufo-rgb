{
  "arch": "small",
  "model": "UFO-B/8",
  "data_root": "data/UFO_paper",
  "dataset": "waymo",
  "train_scene_indices": "621",
  "input_size": [
    160,
    240
  ],
  "num_max_cameras": 3,
  "timespan": 0.5,
  "num_context_timesteps": 1,
  "num_target_timesteps": 2,
  "num_target_chunks": 4,
  "paper_frame_protocol": true,
  "paper_supervision_mode": "per_chunk",
  "batch_size": 1,
  "eval_batch_size": 1,
  "num_workers": 0,
  "pin_memory": false,
  "num_bbox": 32,
  "num_motion_tokens": 0,
  "num_window_chunks": 0,
  "filter_num": 3600,
  "recurrent": true,
  "ar": true,
  "scene_token_input": "official_rgb",
  "disable_legacy_time_offset": true,
  "paper_affine_transform": true,
  "paper_bbox_rotation": false,
  "mask_invalid_bbox_tokens": true,
  "stable_bbox_delta_transform": true,
  "enable_lifespan_renderer": true,
  "lifespan_parameterization": "paper_beta",
  "use_sky_token": true,
  "use_affine_token": true,
  "enable_depth_loss": false,
  "load_depth": false,
  "load_flow": false,
  "enable_flow_reg_loss": false,
  "load_ground": false,
  "load_dynamic_mask": false,
  "skip_sky_mask": true,
  "enable_sky_depth_loss": false,
  "enable_sky_opacity_loss": false,
  "object_assignment_loss_coeff": 0.0,
  "instance_scene_index_manifest": null,
  "pose_free_training": true,
  "pose_free_camera_only": true,
  "pose_free_coordinate_mode": "recurrent",
  "pose_override_mode": "all",
  "pose_override_sequence_dir": "outputs/pose_free_camera/omega_gca_metric",
  "intrinsics_override_mode": "all",
  "intrinsics_override_sequence_dir": "outputs/pose_free_camera/omega_gca_metric",
  "training_sampling_mode": "dynamic_mixture",
  "dynamic_rich_pool": "configs/experiments/pose_free_scene621_windows.json",
  "dynamic_sampling_ratio": 1.0,
  "disable_validation": true,
  "skip_initial_validation": true,
  "skip_final_evaluation": true,
  "allow_missing_paper_components": true,
  "num_iterations": 1,
  "log_every_n_iters": 1,
  "ckpt_every_n_iters": 1
}
