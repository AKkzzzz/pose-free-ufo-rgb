{
  "arch": "small",
  "model": "UFO-B/8",
  "data_root": "data/UFO_paper",
  "dataset": "waymo",
  "input_size": [160, 240],
  "num_max_cameras": 3,
  "timespan": 0.5,
  "num_context_timesteps": 1,
  "num_target_timesteps": 2,
  "num_target_chunks": 4,
  "paper_frame_protocol": true,
  "paper_supervision_mode": "per_chunk",
  "batch_size": 1,
  "eval_batch_size": 1,
  "num_workers": 8,
  "pin_memory": true,
  "non_blocking_h2d": true,
  "prefetch_factor": 4,
  "num_bbox": 32,
  "num_motion_tokens": 0,
  "num_window_chunks": 0,
  "filter_num": 3600,
  "recurrent": true,
  "ar": true,
  "scene_token_input": "official_rgb",
  "disable_legacy_time_offset": true,
  "paper_affine_transform": true,
  "paper_bbox_rotation": true,
  "mask_invalid_bbox_tokens": true,
  "stable_bbox_delta_transform": true,
  "enable_lifespan_renderer": true,
  "lifespan_parameterization": "paper_beta",
  "use_sky_token": true,
  "use_affine_token": true,
  "enable_depth_loss": true,
  "load_depth": true,
  "load_flow": false,
  "load_ground": true,
  "load_dynamic_mask": true,
  "skip_sky_mask": false,
  "instance_scene_index_manifest": "data/UFO_paper/scene_list/waymo_instance_scene_manifest.json",
  "allow_missing_paper_components": true,
  "pose_free_camera_only": true,
  "pose_free_coordinate_mode": "recurrent",
  "pose_override_mode": "all",
  "intrinsics_override_mode": "none"
}
